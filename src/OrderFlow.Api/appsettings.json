{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=orderflow;Username=orderflow;Password=orderflow"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 100,
    "MaxAttempts": 10
  },
  "RabbitMq": {
    "ConnectionString": "amqp://orderflow:orderflow@localhost:5672"
  }
}
